{
  "info": {
    "name": "Interview AI Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        }
      },
      "response": []
    },
    {
      "name": "1. Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Kavya\",\n  \"email\": \"kavya@example.com\",\n  \"password\": \"123456\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "2. Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"kavya@example.com\",\n  \"password\": \"123456\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Sets the httpOnly 'token' cookie. Postman stores it and sends it automatically."
      },
      "response": []
    },
    {
      "name": "3. Get me",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/auth/get-me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "get-me"
          ]
        }
      },
      "response": []
    },
    {
      "name": "4. Generate interview report",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/interview",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "interview"
          ]
        },
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "resume",
              "type": "file",
              "src": [],
              "description": "Choose your resume PDF (max 5 MB)"
            },
            {
              "key": "jobDescription",
              "type": "text",
              "value": "Paste the full job description here"
            },
            {
              "key": "selfDescription",
              "type": "text",
              "value": "Short description of yourself and your strengths"
            }
          ]
        },
        "description": "AI call - can take 10-30 seconds. Saves the new report id into {{reportId}}."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json.report && json.report._id) { pm.collectionVariables.set('reportId', json.report._id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "5. List my reports",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/interview",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "interview"
          ]
        }
      },
      "response": []
    },
    {
      "name": "6. Get report by id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/interview/{{reportId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "interview",
            "{{reportId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "7. Generate resume PDF",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/interview/resume/pdf/{{reportId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "interview",
            "resume",
            "pdf",
            "{{reportId}}"
          ]
        },
        "description": "Use the arrow next to Send -> 'Send and Download' to save the PDF."
      },
      "response": []
    },
    {
      "name": "8. Delete report",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/interview/{{reportId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "interview",
            "{{reportId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "9. Logout",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/auth/logout",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "logout"
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "reportId",
      "value": ""
    }
  ]
}